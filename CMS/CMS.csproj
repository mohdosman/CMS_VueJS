<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CMS</AssemblyName>
    <RootNamespace>CMS</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same id as the Blazor CMS, so its user-secrets (LegacyCrypto) apply here too. -->
    <UserSecretsId>1cb46407-05d3-4666-afb3-c40ef5d1e843</UserSecretsId>
    <SpaRoot>vue-app\</SpaRoot>
    <NoWarn>$(NoWarn);SYSLIB0022;SYSLIB0041</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- Keep vue-app files out of the .NET content pipeline -->
  <ItemGroup>
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <VueSource Include="$(SpaRoot)src\**\*;$(SpaRoot)vite.config.js;$(SpaRoot)package.json;$(SpaRoot)package-lock.json" />
  </ItemGroup>

  <Target Name="NpmInstall" BeforeTargets="ViteBuild" Condition="!Exists('$(SpaRoot)node_modules')">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" />
  </Target>

  <!-- Incremental: reruns Vite only when Vue sources changed. Also runs on publish. -->
  <Target Name="ViteBuild" BeforeTargets="Build" Inputs="@(VueSource)" Outputs="wwwroot\scripts\vue\app.js">
    <Message Importance="high" Text="-- Vite build ($(Configuration))..." />
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>
</Project>
