@{
    ViewBag.Title = "Reset Password";
    Layout = "_LoginLayout";
}

<main class="login-shell password-shell" aria-labelledby="main-title">
    <section class="login-panel" aria-labelledby="main-title">
        <div class="login_box">
            <div class="cnt_b p-4">
                <h1 id="main-title" class="top_b px-0">This reset link is not valid</h1>
                <p class="mt-3">The link has expired, has already been used, or is incomplete. Request a new one and try again.</p>
                <a class="btn btn-primary login-submit" asp-controller="Account" asp-action="ForgotPassword">Request a new link</a>
                <a class="btn btn-outline-secondary login-submit mt-2" asp-controller="Account" asp-action="Login">Back to Login</a>
            </div>
        </div>
    </section>
</main>
