@model CMS.Mvc.ViewModels.VerifyMfaViewModel
@{
    ViewBag.Title = "Verify Your Sign In";
    Layout = "_LoginLayout";
    var modelErrors = ViewData.ModelState.TryGetValue("", out var entry)
        ? entry.Errors.Select(e => e.ErrorMessage).Where(m => !string.IsNullOrWhiteSpace(m)).ToList()
        : new List<string>();
}

<main class="login-shell password-shell" aria-labelledby="main-title">
    <section class="login-panel" aria-labelledby="main-title">
        <h1 id="main-title" class="visually-hidden">Verify your sign in</h1>

        <div class="login_box">
            <form asp-controller="Account" asp-action="VerifyMfa" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="login_form" aria-labelledby="form-title" autocomplete="off">
                <h2 id="form-title" class="top_b">Two-Factor Authentication</h2>

                @if (modelErrors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert" tabindex="-1" id="validation-summary">
                        <h2 class="visually-hidden">There were problems with your submission</h2>
                        <ul class="mb-0">
                            @foreach (var error in modelErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <div class="cnt_b">
                    <div class="mb-3">
                        <label asp-for="Code">Authenticator code</label>
                        <input asp-for="Code" class="form-control" inputmode="numeric" maxlength="7" autocomplete="one-time-code"
                               aria-required="true" aria-describedby="code-help" autofocus />
                        <span asp-validation-for="Code" class="text-danger" role="alert"></span>
                        <div id="code-help" class="field-help">Open Microsoft Authenticator and enter the six digit code.</div>
                    </div>
                </div>

                <div class="btm_b">
                    <button class="btn btn-primary login-submit" type="submit">Verify</button>
                    <a class="btn btn-outline-secondary login-submit mt-2" asp-controller="Account" asp-action="Login">Back to Login</a>
                </div>
            </form>
        </div>
    </section>
</main>
