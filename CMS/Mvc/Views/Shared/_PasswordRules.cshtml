@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Identity
@inject IOptions<IdentityOptions> IdentityOpts
@{
    var pw = IdentityOpts.Value.Password;
}
<section class="password-rules-panel" aria-labelledby="password-rules-heading">
    <h2 id="password-rules-heading">Password requirements</h2>
    <div id="password-rules" aria-live="polite">
        <ul>
            @* Rules come from the same Identity options the server enforces, so they cannot drift. *@
            @if (pw.RequireLowercase)
            {
                <li data-password-rule="lower"><span class="rule-status" aria-hidden="true"></span><span class="visually-hidden rule-state">Not met: </span>At least <strong>one lower case letter</strong></li>
            }
            @if (pw.RequireUppercase)
            {
                <li data-password-rule="upper"><span class="rule-status" aria-hidden="true"></span><span class="visually-hidden rule-state">Not met: </span>At least <strong>one upper case letter</strong></li>
            }
            @if (pw.RequireDigit)
            {
                <li data-password-rule="number"><span class="rule-status" aria-hidden="true"></span><span class="visually-hidden rule-state">Not met: </span>At least <strong>one number</strong></li>
            }
            @if (pw.RequireNonAlphanumeric)
            {
                <li data-password-rule="special"><span class="rule-status" aria-hidden="true"></span><span class="visually-hidden rule-state">Not met: </span>At least <strong>one special character</strong></li>
            }
            <li data-password-rule="length" data-min="@pw.RequiredLength"><span class="rule-status" aria-hidden="true"></span><span class="visually-hidden rule-state">Not met: </span>Be at least <strong>@pw.RequiredLength characters</strong></li>
            @if (pw.RequiredUniqueChars > 1)
            {
                <li data-password-rule="unique" data-min="@pw.RequiredUniqueChars"><span class="rule-status" aria-hidden="true"></span><span class="visually-hidden rule-state">Not met: </span>At least <strong>@pw.RequiredUniqueChars different characters</strong></li>
            }
        </ul>
    </div>
</section>

<script>
        document.addEventListener('DOMContentLoaded', function () {
            var input = document.getElementById('Password');
            var tests = {
                lower: function (v) { return /[a-z]/.test(v); },
                upper: function (v) { return /[A-Z]/.test(v); },
                number: function (v) { return /\d/.test(v); },
                special: function (v) { return /[^A-Za-z0-9]/.test(v); },
                length: function (v, min) { return v.length >= min; },
                unique: function (v, min) { return new Set(v).size >= min; }
            };

            function update() {
                var value = input.value || '';
                document.querySelectorAll('[data-password-rule]').forEach(function (li) {
                    var met = tests[li.getAttribute('data-password-rule')](value, Number(li.getAttribute('data-min')));
                    li.classList.toggle('is-met', met);
                    li.querySelector('.rule-state').textContent = met ? 'Met: ' : 'Not met: ';
                });
            }

            ['input', 'keyup', 'change'].forEach(function (evt) { input.addEventListener(evt, update); });
            update();
        });
    </script>
