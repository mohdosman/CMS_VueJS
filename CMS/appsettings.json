{
  "ApplicationName": "Crisis Management System",
  "ConnectionStrings": {
    "Default": "Server=.;Database=CrisisMgmt_Dev;Integrated Security=true;TrustServerCertificate=true"
  },
  "Session": {
    "CookieName": "cms.session",
    "IdleMinutes": 60
  },
  "LegacyCrypto": {
    "PassPhrase": "__READ_FROM_USER_SECRET__",
    "SaltValue": "__READ_FROM_USER_SECRET__",
    "HashAlgorithm": "SHA1",
    "PasswordIterations": 2,
    "InitVector": "__READ_FROM_USER_SECRET__",
    "KeySize": 256
  },
  "Identity": {
    "User": { "RequireUniqueEmail": false },
    "Tokens": { "TokenLifespan": "02:00:00" },
    "UserName": { "MinLength": 7, "MaxLength": 15, "AdAccountPrefixes": [ "ci", "ag" ] },
    "Password": {
      "RequiredUniqueChars": 3,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    }
  },
  "AssessmentSchema": {
    "SchemaUrl": "https://mhddapps.state.tn.us/Schemas/CrisisAssessment.xsd",
    "SampleXmlUrl": "https://mhddapps.state.tn.us/Schemas/SampleCrisisAssessment.xml",
    "LastUpdated": "2026-07-24"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "f345bebf-0d71-4337-9281-24b941616c36",
    "ClientId": "9741b152-8dab-4bfe-b1af-70b427fe7f07",
    "CallbackPath": "/signin-oidc"
  },
  "Mfa": {
    "Issuer": "CMS_MFA"
  },
  "App": {
    "BaseUrl": ""
  },
  "Smtp": {
    "Host": "mxsb2.tn.gov",
    "Port": 587,
    "FromName": "Crisis Management System",
    "FromAddress": "MH.Applications@tn.gov",
    "User": "",
    "Password": "",
    "UseStartTls": true,
    "UseSsl": false
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "Logs/log-.txt", "rollingInterval": "Day", "retainedFileCountLimit": 10, "shared": true }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
