@model CrisisManagement.Mvc.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
    Layout = "_LoginLayout";
    var modelErrors = ViewData.ModelState.TryGetValue("", out var entry)
        ? entry.Errors.Select(e => e.ErrorMessage).Where(m => !string.IsNullOrWhiteSpace(m)).ToList()
        : new List<string>();
}

<main class="login-shell password-shell" aria-labelledby="main-title">
    <section class="login-panel" aria-labelledby="main-title">
        <h1 id="main-title" class="visually-hidden">Change Password</h1>

        <div class="login_box password-card">
            <form asp-controller="Account" asp-action="Change" method="post" id="login_form" aria-labelledby="form-title" autocomplete="off">
                <h2 id="form-title" class="top_b">Change Password</h2>

                @if (TempData["StatusMessage"] is string statusMessage)
                {
                    <div class="alert alert-success" role="status">@statusMessage</div>
                }
                @if (modelErrors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert" tabindex="-1" id="validation-summary">
                        <h2 class="visually-hidden">There were problems with your submission</h2>
                        <ul class="mb-0">
                            @foreach (var error in modelErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <div class="cnt_b">
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">Current Password <span aria-hidden="true">*</span></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" aria-required="true" autofocus />
                        <span asp-validation-for="CurrentPassword" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">New Password <span aria-hidden="true">*</span></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true"
                               aria-describedby="password-rules" />
                        <span asp-validation-for="Password" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm New Password <span aria-hidden="true">*</span></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true"
                               aria-describedby="password-rules" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger" role="alert"></span>
                    </div>
                </div>

                <div class="btm_b">
                    <button class="btn btn-primary login-submit" type="submit">Change Password</button>
                    <a class="btn btn-outline-secondary login-submit mt-2" asp-controller="Home" asp-action="Index">Back to application</a>
                </div>
            </form>

            <partial name="_PasswordRules" />
        </div>
    </section>
</main>
