@model CrisisManagement.Mvc.ViewModels.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
    Layout = "_LoginLayout";
    var modelErrors = ViewData.ModelState.TryGetValue("", out var entry)
        ? entry.Errors.Select(e => e.ErrorMessage).Where(m => !string.IsNullOrWhiteSpace(m)).ToList()
        : new List<string>();
    var sent = ViewData["Sent"] is true;
}

<main class="login-shell password-shell" aria-labelledby="main-title">
    <section class="login-panel" aria-labelledby="main-title">
        <h1 id="main-title" class="visually-hidden">Forgot Password</h1>

        <div class="login_box">
            <form asp-controller="Account" asp-action="ForgotPassword" method="post" id="login_form" aria-labelledby="form-title" autocomplete="off">
                <h2 id="form-title" class="top_b">Forgot Password</h2>

                @if (sent)
                {
                    <div class="alert alert-success" role="status">
                        If the account exists, a reset link has been sent to the associated email address.
                        Please check your inbox and spam folder.
                    </div>
                }
                @if (modelErrors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert" tabindex="-1" id="validation-summary">
                        <h2 class="visually-hidden">There were problems with your submission</h2>
                        <ul class="mb-0">
                            @foreach (var error in modelErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <div class="cnt_b">
                    <p class="field-help">Enter your user ID or email address and we'll send you a link to reset your password.</p>
                    <div class="mb-3">
                        <label asp-for="UserNameOrEmail">User ID/Email</label>
                        <input asp-for="UserNameOrEmail" class="form-control" autocomplete="username" aria-required="true" autofocus />
                        <span asp-validation-for="UserNameOrEmail" class="text-danger" role="alert"></span>
                    </div>
                    <p class="field-help">Active Directory (State) accounts reset their password through Microsoft, not here.</p>
                </div>

                <div class="btm_b">
                    <button class="btn btn-primary login-submit" type="submit">Send Reset Link</button>
                    <a class="btn btn-outline-secondary login-submit mt-2" asp-controller="Account" asp-action="Login">Back to Login</a>
                </div>
            </form>
        </div>
    </section>
</main>
