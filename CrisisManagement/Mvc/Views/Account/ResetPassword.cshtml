@model CrisisManagement.Mvc.ViewModels.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
    Layout = "_LoginLayout";
    var modelErrors = ViewData.ModelState.TryGetValue("", out var entry)
        ? entry.Errors.Select(e => e.ErrorMessage).Where(m => !string.IsNullOrWhiteSpace(m)).ToList()
        : new List<string>();
}

<main class="login-shell password-shell" aria-labelledby="main-title">
    <section class="login-panel" aria-labelledby="main-title">
        <h1 id="main-title" class="visually-hidden">Reset Password</h1>

        <div class="login_box password-card">
            <form asp-controller="Account" asp-action="ResetPassword" method="post" id="login_form" aria-labelledby="form-title" autocomplete="off">
                <h2 id="form-title" class="top_b">Reset Password</h2>

                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />

                @if (modelErrors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert" tabindex="-1" id="validation-summary">
                        <h2 class="visually-hidden">There were problems with your submission</h2>
                        <ul class="mb-0">
                            @foreach (var error in modelErrors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <div class="cnt_b">
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">New Password <span aria-hidden="true">*</span></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true"
                               aria-describedby="password-rules" autofocus />
                        <span asp-validation-for="Password" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm New Password <span aria-hidden="true">*</span></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true"
                               aria-describedby="password-rules" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger" role="alert"></span>
                    </div>
                </div>

                <partial name="_PasswordRules" />

                <div class="btm_b">
                    <button class="btn btn-primary login-submit" type="submit">Update Password</button>
                    <a class="btn btn-outline-secondary login-submit mt-2" asp-controller="Account" asp-action="Login">Back to Login</a>
                </div>
            </form>
        </div>
    </section>
</main>
