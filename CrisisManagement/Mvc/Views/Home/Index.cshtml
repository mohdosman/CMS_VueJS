@model CrisisManagement.Mvc.ViewModels.HomeViewModel
@{
    ViewData["ApplicationName"] = Model.ApplicationName;
}

@section styles {
    <link href="~/scripts/vue/app.css" rel="stylesheet" type="text/css" asp-append-version="true" />
}

<partial name="_Navigation" model="Model" />

<div id="maincontainer" class="clearfix">
    <div id="vue-app" tabindex="-1"></div>
</div>

@section scripts {
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/selectNav.js" asp-append-version="true"></script>
    <script type="application/json" id="__cms_boot__">@Html.Raw(Model.ToBootstrapJson())</script>
    @* Single-file bundle (inlineDynamicImports), so asp-append-version is safe here. *@
    <script type="module" src="~/scripts/vue/app.js" asp-append-version="true"></script>
}
