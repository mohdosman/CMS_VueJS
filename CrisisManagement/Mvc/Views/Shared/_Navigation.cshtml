@model HomeViewModel
@{
    // Change Password is a menu item in the database, but it belongs on the right with Help and Logout
    // (as in SafetyNet) and opens the MVC Account/Change page. It only shows for users whose menu contains it.
    var changePassword = CrisisManagement.Features.Menus.MenuService.Flatten(Model.Menu).FirstOrDefault(n => n.Url == "/change-password");
}

<header role="banner">
    <a class="skip-link" href="#vue-app">Skip to main content</a>
    <!-- Screen-reader live region used by vue-app/src/services/liveAnnouncer.js -->
    <div aria-live="polite" aria-atomic="true" class="visually-hidden" id="global-aria-status-message"></div>
    <nav class="navbar navbar-expand fixed-top" aria-label="Main navigation">
        <div class="navbar-inner">
            <div class="container-fluid d-flex flex-wrap align-items-center">
                <a class="brand" href="~/" aria-label="@Model.ApplicationName home">@Model.ApplicationName</a>

                <ul class="nav navbar-nav" id="mobile-nav">
                    @foreach (var item in Model.Menu)
                    {
                        if (item.Url == "/change-password") { continue; }
                        if (item.Children.Count > 0)
                        {
                            <li class="dropdown">
                                <button type="button" class="dropdown-toggle" aria-haspopup="true" aria-expanded="false"
                                        aria-controls="nav-dropdown-@item.Id">
                                    @if (item.Icon != "") { <span class="fa @item.Icon" aria-hidden="true"></span> }
                                    @item.Name
                                </button>
                                <ul class="dropdown-menu" id="nav-dropdown-@item.Id">
                                    @foreach (var child in item.Children)
                                    {
                                        <li>
                                            @if (child.Children.Count > 0)
                                            {
                                                @* Third level (e.g. Administration > Security > Users); common.js turns the nested ul into a flyout. *@
                                                <a class="dropdown-item" href="#" role="button" aria-haspopup="true" onclick="return false">@child.Name</a>
                                                <ul class="dropdown-menu">
                                                    @foreach (var leaf in child.Children)
                                                    {
                                                        <li><a class="dropdown-item" href="#@leaf.Url">@leaf.Name</a></li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item" href="#@child.Url">@child.Name</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        else if (item.Url != "")
                        {
                            <li>
                                <a href="#@item.Url">
                                    @if (item.Icon != "") { <span class="fa @item.Icon" aria-hidden="true"></span> }
                                    @item.Name
                                </a>
                            </li>
                        }
                    }
                </ul>

                <nav class="user-nav ms-auto" aria-label="User menu">
                    <ul class="nav navbar-nav user_menu">
                        @* Same pattern as SafetyNet: Help and Logout sit in the bar on wide screens, and
                           below 1440px style.css hides them and shows the copies inside the user dropdown. *@
                        <li class="user-link-wide">
                            <button type="button" onclick="window.cms?.openHelp()">
                                <span class="fa fa-book" aria-hidden="true"></span>
                                <span class="user-link-text">Help</span>
                            </button>
                        </li>
                        @if (changePassword is not null)
                        {
                            <li class="user-link-wide">
                                <a asp-controller="Account" asp-action="Change">
                                    <span class="fa fa-lock" aria-hidden="true"></span>
                                    <span class="user-link-text">@changePassword.Name</span>
                                </a>
                            </li>
                        }
                        <li class="user-link-wide">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit">
                                    <span class="fa fa-sign-out" aria-hidden="true"></span>
                                    <span class="user-link-text">Logout</span>
                                </button>
                            </form>
                        </li>
                        <li class="dropdown">
                            <button type="button" class="dropdown-toggle" aria-haspopup="true" aria-expanded="false"
                                    aria-controls="user-menu-dropdown">
                                <span class="fa fa-user" aria-hidden="true"></span>
                                @Model.FullName
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" id="user-menu-dropdown">
                                @* Links (role="button"), not <button>s, so every theme's ".dropdown-menu li > a" rules style them. *@
                                <li class="user-link-compact">
                                    <a class="dropdown-item" href="#" role="button" onclick="window.cms?.openHelp(); return false;">
                                        <span class="fa fa-book" aria-hidden="true"></span> Help
                                    </a>
                                </li>
                                @if (changePassword is not null)
                                {
                                    <li class="user-link-compact">
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Change">
                                            <span class="fa fa-lock" aria-hidden="true"></span> @changePassword.Name
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item" href="~/#/profile">
                                        <span class="fa fa-id-card-o" aria-hidden="true"></span> My Profile
                                    </a>
                                </li>
                                @* Local accounts only: AD accounts get MFA from Microsoft. *@
                                @if (!Model.IsADAccount)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="SetupMfa">
                                            <span class="fa fa-mobile" aria-hidden="true"></span> Two-Factor Authentication
                                        </a>
                                    </li>
                                }
                                <li class="user-link-compact">
                                    <a class="dropdown-item" href="#" role="button" onclick="document.getElementById('logout-form').submit(); return false;">
                                        <span class="fa fa-sign-out" aria-hidden="true"></span> Logout
                                    </a>
                                </li>
                                <li class="user-link-compact"><hr class="dropdown-divider"></li>
                                <li class="theme-picker-item" aria-label="Theme selection">
                                    <span class="theme-picker-label" aria-hidden="true">Theme</span>
                                    <div class="theme-swatches" role="group" aria-label="Select colour theme">
                                        <button type="button" class="theme-swatch" data-theme="navy" style="background:#002D65" aria-label="Navy theme" aria-pressed="false" title="Navy"></button>
                                        <button type="button" class="theme-swatch" data-theme="blue" style="background:#0074B8" aria-label="Blue theme" aria-pressed="false" title="Blue"></button>
                                        <button type="button" class="theme-swatch" data-theme="dark" style="background:#171e27" aria-label="Dark theme" aria-pressed="false" title="Dark"></button>
                                        <button type="button" class="theme-swatch" data-theme="green" style="background:#5f7035" aria-label="Green theme" aria-pressed="false" title="Green"></button>
                                        <button type="button" class="theme-swatch" data-theme="brown" style="background:#7a5529" aria-label="Brown theme" aria-pressed="false" title="Brown"></button>
                                        <button type="button" class="theme-swatch" data-theme="eastern_blue" style="background:#197a8e" aria-label="Eastern Blue theme" aria-pressed="false" title="Eastern Blue"></button>
                                        <button type="button" class="theme-swatch" data-theme="tamarillo" style="background:#af2c36" aria-label="Tamarillo theme" aria-pressed="false" title="Tamarillo"></button>
                                    </div>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </nav>
    <form id="logout-form" asp-controller="Account" asp-action="Logout" method="post" hidden></form>
</header>
