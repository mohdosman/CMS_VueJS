# Copy to .env.test.local (ignored by git) and fill in. The user needs Administrator, or at least the screens under test.
CMS_BASE_URL=https://localhost:7031
CMS_USERNAME=your-user-id
CMS_PASSWORD=your-password
# Extra exact routes for the axe and keyboard scans (record pages need a real id), comma separated.
A11Y_EXTRA_ROUTES=
A11Y_KEYBOARD_TAB_PRESSES=40
A11Y_KEYBOARD_MIN_UNIQUE_FOCUS_TARGETS=1
