{
  "name": "cms-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint \"src/**/*.{js,vue}\"",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "test:a11y": "playwright test --project=chromium-a11y",
    "test:a11y:axe": "playwright test tests/routes.a11y.spec.js",
    "test:a11y:keyboard": "playwright test tests/keyboard.spec.js",
    "test:e2e": "playwright test --project=chromium-e2e",
    "test:e2e:headed": "playwright test --project=chromium-e2e --headed",
    "test:all": "playwright test"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "espree": "^11.2.0",
    "globals": "^17.11.0",
    "vite": "^6.4.3"
  }
}
